@model RestaurantAi.Mvc.Models.ReservationViewModel
@{
    ViewData["Title"] = "Reservation Details";
    Layout = "_Layout";
}

<div class="container py-8">
    <h1 class="mb-4">Reservation Details</h1>

    <dl class="row">
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.Date.ToString("MMMM d, yyyy")</dd>

        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">@Model.Time</dd>

        <dt class="col-sm-3">Party Size</dt>
        <dd class="col-sm-9">@Model.PartySize</dd>

        <dt class="col-sm-3">Special Requests</dt>
        <dd class="col-sm-9">@Model.SpecialRequests</dd>
    </dl>

    <div class="mt-4">
        <a asp-action="List" asp-controller="Booking" class="btn btn-secondary">Back to Bookings</a>
        <a asp-action="Edit" asp-controller="Booking" asp-route-id="@Model.Id" class="btn btn-primary ms-2">Edit</a>

        <form asp-action="Delete" asp-controller="Booking" method="post" class="d-inline ms-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cancel this reservation?');">Cancel Reservation</button>
        </form>
    </div>
</div>
