@model RestaurantAi.Mvc.Models.ReservationViewModel
@{
    ViewData["Title"] = "DineReserve AI - Assisted Booking";
}

<div class="layout-container flex h-full grow flex-col">
    <main class="flex-1 flex justify-center py-6 lg:py-10">
        <div class="flex flex-col w-full max-w-[1280px] px-4 md:px-8">

            @{
                if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
            }
            @{
                if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
            }

            <div class="flex flex-wrap justify-center items-end gap-4 mb-10">
                <div class="flex flex-col gap-2 items-center text-center">
                    <div class="flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[16px]">restaurant</span>
                        Reservation Request
                    </div>
                    <h1 class="text-3xl md:text-5xl font-black leading-tight tracking-tight">Table for Two at L'Artiste</h1>
                    <div class="flex items-center gap-3">
                        <span class="text-[var(--text-muted)] text-base font-medium flex items-center gap-1">
                            <span class="material-symbols-outlined text-[18px]">location_on</span> Manhattan, NY
                        </span>
                        <span>&bull;</span>
                        <span class="text-[var(--text-muted)] text-base font-medium">French Fine Dining</span>
                        <span>&bull;</span>
                        <div class="flex items-center gap-1 bg-amber-100 text-amber-700 px-2 py-0.5 rounded-lg text-sm font-bold">
                            <span class="material-symbols-outlined text-[14px]">star</span> 4.8
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-8 max-w-2xl mx-auto w-full">

                <!-- Reservation Form -->
                <div class="bg-[var(--bg-light)] rounded-2xl border border-[var(--border)] p-8 shadow-sm">
                    <div class="flex items-center gap-2 mb-6">
                        <span class="material-symbols-outlined text-gold">description</span>
                        <h3 class="text-xl font-bold">Make a Reservation</h3>
                    </div>

                    <form asp-action="Create" asp-controller="Booking" method="post" class="space-y-5">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Date</label>
                            <input asp-for="Date" type="date" class="form-control form-input rounded-xl w-full h-12 px-4" />
                            <span asp-validation-for="Date" class="text-danger text-xs"></span>
                        </div>

                        <div class="form-group">
                            <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Time</label>
                            <input asp-for="Time" class="form-control form-input rounded-xl w-full h-12 px-4" placeholder="7:00 PM" />
                            <span asp-validation-for="Time" class="text-danger text-xs"></span>
                        </div>

                        <div class="form-group">
                            <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Party Size</label>
                            <input asp-for="PartySize" type="number" min="1" max="20" class="form-control form-input rounded-xl w-full h-12 px-4" />
                            <span asp-validation-for="PartySize" class="text-danger text-xs"></span>
                        </div>

                        <div class="form-group">
                            <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Special Requests</label>
                            <input asp-for="SpecialRequests" class="form-control form-input rounded-xl w-full h-12 px-4" placeholder="Allergies, seating, etc." />
                        </div>

                        <div class="flex items-center gap-3 pt-2">
                            <button type="submit" class="flex items-center gap-2 h-12 px-6 bg-gold text-white font-black rounded-xl shadow-lg shadow-gold/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                                <span class="material-symbols-outlined text-[18px]">check_circle</span> Confirm Reservation
                            </button>
                            <a asp-action="List" asp-controller="Booking" class="flex items-center gap-2 h-12 px-6 border border-[var(--border)] rounded-xl font-bold text-sm hover:bg-[var(--bg-soft-gray)] transition-colors">
                                View My Bookings
                            </a>
                        </div>
                    </form>
                </div>

                <div class="flex gap-5 p-6 rounded-2xl bg-gold/5 border border-gold/10 items-start">
                    <div class="size-10 rounded-full bg-gold/20 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-gold">notifications_active</span>
                    </div>
                    <div>
                        <h4 class="font-extrabold text-base mb-1">Reservation Policy</h4>
                        <p class="text-sm text-[var(--text-muted)] leading-relaxed">Tables are held for 15 minutes. Cancellations made within 24 hours may incur a $25 fee per guest.</p>
                    </div>
                </div>
            </div>

            <footer class="mt-16 flex flex-col md:flex-row justify-between items-center gap-8 py-10 border-t border-[var(--border)]">
                <div class="flex items-center gap-4 text-[var(--text-muted)]">
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-bold uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[16px] text-emerald-500">verified_user</span> SSL Secured
                    </div>
                    <p class="text-xs font-medium">&copy; @DateTime.Now.Year DineReserve AI. All rights reserved.</p>
                </div>
                <div class="flex gap-8">
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" href="#">Terms</a>
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" asp-action="Privacy" asp-controller="Home">Privacy</a>
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" href="#">Support</a>
                </div>
            </footer>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}