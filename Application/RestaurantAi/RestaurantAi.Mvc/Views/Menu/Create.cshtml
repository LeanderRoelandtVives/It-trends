@model RestaurantAi.Mvc.Models.MenuItemViewModel
@{
    ViewData["Title"] = "Add Menu Item";
}

<main class="max-w-2xl mx-auto px-8 py-16">
    <div class="mb-10">
        <a asp-controller="Menu" asp-action="Index"
           class="flex items-center gap-2 text-[var(--text-muted)] hover:text-gold transition-colors text-sm font-bold mb-6">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to Menu
        </a>
        <h1 class="text-4xl font-black text-[var(--text-main)]">Add Menu Item</h1>
    </div>

    <form asp-action="Create" method="post"
          class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 flex flex-col gap-6">
        @Html.AntiForgeryToken()

        <div class="flex flex-col gap-2">
            <label class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)]">Name</label>
            <input asp-for="Name" class="w-full border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-main)] rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="e.g. Grilled Salmon" />
            <span asp-validation-for="Name" class="text-red-500 text-xs"></span>
        </div>

        <div class="flex flex-col gap-2">
            <label class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)]">Description</label>
            <textarea asp-for="Description" rows="3" class="w-full border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-main)] rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all resize-none" placeholder="Describe the dish..."></textarea>
            <span asp-validation-for="Description" class="text-xs text-red-500"></span>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
                <label class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)]">Price (€)</label>
                <input asp-for="Price" type="number" step="0.01" class="w-full border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-main)] rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-xs text-red-500"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)]">Category</label>
                <input asp-for="Category" class="w-full border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-main)] rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="e.g. Starters" />
                <span asp-validation-for="Category" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <label class="text-xs font-black uppercase tracking-widest text-[var(--text-muted)]">Image URL</label>
            <input asp-for="ImageUrl" class="w-full border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-main)] rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="https://..." />
        </div>

        <button type="submit"
                class="w-full py-4 bg-gold text-white font-black rounded-xl hover:shadow-lg hover:shadow-gold/30 transition-all mt-2">
            Save Menu Item
        </button>
    </form>
</main>