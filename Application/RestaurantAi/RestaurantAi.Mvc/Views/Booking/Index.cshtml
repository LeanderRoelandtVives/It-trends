@model RestaurantAi.Mvc.Models.ReservationViewModel
@{
    ViewData["Title"] = "Make a Reservation";
    Layout = "_Layout";
}

<div class="container py-8">
    <h1 class="mb-4">Reserve a Table</h1>

    <form method="post" asp-controller="Booking" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Date</label>
            <input asp-for="Date" class="form-control" type="date" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Time</label>
            <input asp-for="Time" class="form-control" placeholder="7:00 PM" />
            <span asp-validation-for="Time" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Party Size</label>
            <input asp-for="PartySize" class="form-control" type="number" min="1" max="20" />
            <span asp-validation-for="PartySize" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Special Requests</label>
            <input asp-for="SpecialRequests" class="form-control" placeholder="Allergies, seating, etc." />
        </div>

        <button type="submit" class="btn btn-primary">Confirm Reservation</button>
    </form>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}