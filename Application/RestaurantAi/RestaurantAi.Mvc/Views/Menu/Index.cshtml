@model Dictionary<string, List<RestaurantAi.Mvc.Models.MenuItemViewModel>>
@{
    ViewData["Title"] = "Our Menu";
    var isAdmin = ViewData["IsAdmin"] is true;
}

<main class="max-w-4xl mx-auto px-8 py-16">

    <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-2 text-gold font-bold text-xs uppercase tracking-[0.3em] mb-4">
            <div class="h-px w-12 bg-gold"></div>
            Est. 2024
            <div class="h-px w-12 bg-gold"></div>
        </div>
        <h1 class="text-6xl font-black text-[var(--text-main)] tracking-tight mb-3">Our Menu</h1>
        <p class="text-[var(--text-muted)] font-medium">Freshly prepared with the finest ingredients</p>
        @if (isAdmin)
        {
            <a asp-controller="Menu" asp-action="Create"
               class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-gold text-white font-bold rounded-xl hover:shadow-lg hover:shadow-gold/30 transition-all">
                <span class="material-symbols-outlined text-[18px]">add</span>
                Add Item
            </a>
        }
    </div>

    @foreach (var category in Model)
    {
        <section class="mb-20">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-black text-[var(--text-main)] tracking-tight uppercase">@category.Key</h2>
                <div class="flex items-center justify-center gap-3 mt-3">
                    <div class="h-px w-16 bg-[var(--border)]"></div>
                    <span class="material-symbols-outlined text-gold text-[16px]">restaurant</span>
                    <div class="h-px w-16 bg-[var(--border)]"></div>
                </div>
            </div>

            <div class="flex flex-col divide-y divide-dashed divide-[var(--border)]">
                @foreach (var item in category.Value)
                {
                    <div class="flex items-start gap-6 py-8 group">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <div class="w-24 h-24 rounded-xl overflow-hidden shrink-0 shadow-sm border border-[var(--border)]">
                                <img src="@item.ImageUrl" alt="@item.Name"
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            </div>
                        }

                        <div class="flex-1 min-w-0">
                            <div class="flex items-baseline justify-between gap-4 mb-1">
                                <h3 class="text-xl font-black text-[var(--text-main)]">@item.Name</h3>
                                <div class="flex-1 border-b border-dotted border-[var(--border)] mb-1 mx-2"></div>
                                <span class="text-gold font-black text-lg shrink-0">€@item.Price.ToString("0.00")</span>
                            </div>
                            <p class="text-sm text-[var(--text-muted)] leading-relaxed">@item.Description</p>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="flex gap-2 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                                <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id"
                                   class="px-3 py-1.5 border border-[var(--border)] text-[var(--text-muted)] text-xs font-bold rounded-lg hover:border-gold hover:text-gold transition-colors">
                                    Edit
                                </a>
                                <form asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            onclick="return confirm('Delete @item.Name?')"
                                            class="px-3 py-1.5 text-red-500 text-xs font-bold rounded-lg hover:bg-red-50 transition-colors border border-red-200">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-32">
            <span class="material-symbols-outlined text-6xl text-[var(--text-muted)] mb-4 block">restaurant_menu</span>
            <p class="text-xl text-[var(--text-muted)] font-medium">No menu items yet.</p>
            @if (isAdmin)
            {
                <a asp-controller="Menu" asp-action="Create"
                   class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-gold text-white font-bold rounded-xl hover:shadow-lg transition-all">
                    <span class="material-symbols-outlined">add</span> Add your first item
                </a>
            }
        </div>
    }

</main>
