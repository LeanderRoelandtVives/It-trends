@{
    ViewData["Title"] = "DineReserve AI - Assisted Booking";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: "#B08E21",
                        charcoal: "#111827",
                        "soft-gray": "#f9fafb"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @@layer base {
            :root {
                --primary: #121212;
                --accent: #B08E21;
                --bg-light: #ffffff;
                --bg-soft-gray: #f9fafb;
                --text-main: #111827;
                --text-muted: #6b7280;
                --border: #e5e7eb;
            }
            body {
                font-family: 'Manrope', sans-serif;
            }
        }
        .font-display {
            font-family: 'Manrope', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24
        }
        .gold-gradient {
            background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%);
        }
    </style>
</head>
<body class="bg-[var(--bg-soft-gray)] font-display text-[var(--text-main)] min-h-screen transition-colors duration-300">
    
    <header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-white/95 backdrop-blur-md">
        <div class="max-w-[1440px] mx-auto px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-12">
                <div class="flex items-center gap-3">
                    <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                        <span class="material-symbols-outlined font-bold">restaurant_menu</span>
                    </div>
                    <h1 class="text-2xl font-extrabold tracking-tight uppercase text-charcoal">
                        DineAI
                    </h1>
                </div>

                <nav class="hidden lg:flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        EXPLORE
                    </a>
                    <a asp-controller="Home" asp-action="Dashboard"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        CONCIERGE
                    </a>
                    <a asp-controller="Booking" asp-action="Index"
                       class="text-sm font-bold tracking-wide text-gold transition-colors">
                        MY BOOKINGS
                    </a>
                    <a asp-controller="Home" asp-action="Privacy"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        PRIVACY
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-6">
                <!-- Language Switcher -->
                <div class="relative">
                    <button id="languageButton" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-[var(--text-main)] hover:bg-gray-50 transition-all border border-[var(--border)] group">
                        <span class="material-symbols-outlined text-lg">language</span>
                        <span id="currentLanguage" class="text-sm font-bold">EN</span>
                        <span class="material-symbols-outlined text-sm group-hover:rotate-180 transition-transform">expand_more</span>
                    </button>
                    <div id="languageMenu" class="hidden absolute right-0 mt-2 w-40 bg-white rounded-xl shadow-xl border border-[var(--border)] overflow-hidden z-50">
                        <button onclick="setLanguage('en')" class="w-full px-4 py-3 text-left text-sm font-semibold hover:bg-gold/10 hover:text-gold transition-colors flex items-center gap-3">
                            <span class="text-lg">🇬🇧</span> English
                        </button>
                        <button onclick="setLanguage('nl')" class="w-full px-4 py-3 text-left text-sm font-semibold hover:bg-gold/10 hover:text-gold transition-colors flex items-center gap-3">
                            <span class="text-lg">🇳🇱</span> Nederlands
                        </button>
                    </div>
                </div>

                <div class="h-6 w-px bg-[var(--border)]"></div>

                <div class="flex items-center gap-4">
                    <a asp-controller="Account" asp-action="Login"
                       class="text-sm font-semibold text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="px-6 py-2.5 bg-gold text-white text-sm font-bold rounded-lg hover:shadow-lg hover:shadow-gold/30 transition-all">
                        Get Started
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="layout-container flex h-full grow flex-col">
        <main class="flex-1 flex justify-center py-6 lg:py-10">
            <div class="flex flex-col w-full max-w-[1280px] px-4 md:px-8">
                <div class="flex flex-wrap justify-between items-end gap-4 mb-10">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
                            <span class="material-symbols-outlined text-[16px]">restaurant</span>
                            Reservation Request
                        </div>
                        <h1 class="text-3xl md:text-5xl font-black leading-tight tracking-tight">Table for Two at L'Artiste</h1>
                        <div class="flex items-center gap-3">
                            <span class="text-[var(--text-muted)] text-base font-medium flex items-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">location_on</span> Manhattan, NY
                            </span>
                            <span>&bull;</span>
                            <span class="text-[var(--text-muted)] text-base font-medium">French Fine Dining</span>
                            <span>&bull;</span>
                            <div class="flex items-center gap-1 bg-amber-100 text-amber-700 px-2 py-0.5 rounded-lg text-sm font-bold">
                                <span class="material-symbols-outlined text-[14px]">star</span> 4.8
                            </div>
                        </div>
                    </div>
                    <a asp-action="Index" asp-controller="Home"
                       class="flex items-center gap-2 rounded-xl h-11 px-6 bg-white text-charcoal text-sm font-bold hover:bg-gray-50 transition-all">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to Discovery
                    </a>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-1 gap-8 items-start max-w-3xl mx-auto w-full">
                    <div class="bg-white rounded-2xl border border-[var(--border)] p-8 shadow-sm">
                        <div class="flex items-center justify-between mb-8">
                            <h3 class="text-xl font-bold">Select Date &amp; Time</h3>
                            <div class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">Step 1 of 2</div>
                        </div>
                        
                        <div class="flex flex-col items-center gap-4 max-w-[400px] mx-auto">
                            <div class="flex items-center justify-between w-full mb-2">
                                <button class="p-2 rounded-xl bg-[var(--bg-soft-gray)] hover:bg-gray-100 transition-colors">
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </button>
                                <p class="text-lg font-extrabold">October 2023</p>
                                <button class="p-2 rounded-xl bg-[var(--bg-soft-gray)] hover:bg-gray-100 transition-colors">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </button>
                            </div>
                            <div class="grid grid-cols-7 w-full gap-1">
                                @foreach (var d in new[] { "S", "M", "T", "W", "T", "F", "S" })
                                {
                                    <p class="text-[var(--text-muted)] text-xs font-black uppercase text-center py-2">@d</p>
                                }
                                <div class="col-start-4"></div>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    if (i == 5)
                                    {
                                        <button class="h-12 w-full flex items-center justify-center rounded-xl bg-gold text-white font-black shadow-lg shadow-gold/30">@i</button>
                                    }
                                    else
                                    {
                                        <button class="h-12 w-full flex items-center justify-center rounded-xl hover:bg-gray-100 font-bold transition-colors">@i</button>
                                    }
                                }
                            </div>
                        </div>

                        <div class="my-8 border-t border-gray-100"></div>

                        <h3 class="text-xs font-black uppercase text-[var(--text-muted)] tracking-widest mb-4">Party Size</h3>
                        <div class="flex gap-2 flex-wrap mb-8">
                            <button class="h-10 px-5 rounded-xl bg-gray-100 font-bold text-sm transition-colors hover:bg-gold/10 hover:text-gold">1 Guest</button>
                            <button class="h-10 px-5 rounded-xl bg-gold/10 border-2 border-gold text-gold font-black text-sm">2 Guests</button>
                            <button class="h-10 px-5 rounded-xl bg-gray-100 font-bold text-sm transition-colors hover:bg-gold/10 hover:text-gold">3 Guests</button>
                            <button class="h-10 px-5 rounded-xl bg-gray-100 font-bold text-sm transition-colors hover:bg-gold/10 hover:text-gold">4 Guests</button>
                            <button class="h-10 px-5 rounded-xl bg-gray-100 font-bold text-sm transition-colors hover:bg-gold/10 hover:text-gold">5+</button>
                        </div>

                        <h3 class="text-xs font-black uppercase text-[var(--text-muted)] tracking-widest mb-4">Available Times</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
                            @foreach (var slot in new[] { ("6:00 PM", false), ("6:30 PM", false), ("7:00 PM", true), ("7:30 PM", false), ("8:00 PM", false), ("8:30 PM", false), ("9:00 PM", false), ("9:30 PM", false) })
                            {
                                if (slot.Item2)
                                {
                                    <button class="h-12 rounded-xl bg-gold text-white font-black text-sm shadow-md shadow-gold/20">@slot.Item1</button>
                                }
                                else if (slot.Item1 == "9:30 PM")
                                {
                                    <button class="h-12 rounded-xl bg-gray-100 font-bold text-sm opacity-40 cursor-not-allowed" disabled>@slot.Item1</button>
                                }
                                else
                                {
                                    <button class="h-12 rounded-xl bg-gray-100 font-bold text-sm hover:ring-2 hover:ring-gold/50 transition-all">@slot.Item1</button>
                                }
                            }
                        </div>

                        <div class="flex gap-3">
                            <button class="flex-1 py-4 bg-charcoal text-white font-bold rounded-xl hover:bg-charcoal/90 transition-all">
                                Continue to Details
                            </button>
                            <button class="px-6 py-4 border-2 border-charcoal text-charcoal font-bold rounded-xl hover:bg-charcoal hover:text-white transition-all">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <div class="flex gap-5 p-6 rounded-2xl bg-gold/5 border border-gold/10 items-start">
                        <div class="size-10 rounded-full bg-gold/20 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-gold">notifications_active</span>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-base mb-1">Reservation Policy</h4>
                            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Tables are held for 15 minutes. Cancellations made within 24 hours may incur a $25 fee per guest.</p>
                        </div>
                    </div>

                    <div class="text-center">
                        <p class="text-sm text-[var(--text-muted)] mb-4">Need help finding a restaurant?</p>
                        <a asp-controller="Home" asp-action="Dashboard"
                           class="inline-flex items-center gap-2 px-6 py-3 bg-gold/10 text-gold font-bold rounded-xl hover:bg-gold/20 transition-all border border-gold/20">
                            <span class="material-symbols-outlined">smart_toy</span>
                            Ask AI Concierge
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
<script>
    // Simple language switcher for Booking page
    let currentLang = localStorage.getItem('language') || 'en';
    
    function setLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('language', lang);
        document.getElementById('currentLanguage').textContent = lang.toUpperCase();
        document.getElementById('languageMenu').classList.add('hidden');
        // In a full implementation, you would reload content or redirect
    }
    
    // Set initial language
    document.getElementById('currentLanguage').textContent = currentLang.toUpperCase();
    
    // Toggle language menu
    document.getElementById('languageButton')?.addEventListener('click', function(e) {
        e.stopPropagation();
        document.getElementById('languageMenu').classList.toggle('hidden');
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', function(e) {
        const menu = document.getElementById('languageMenu');
        const button = document.getElementById('languageButton');
        if (menu && button && !menu.contains(e.target) && !button.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });
    
    window.setLanguage = setLanguage;
</script>
</html