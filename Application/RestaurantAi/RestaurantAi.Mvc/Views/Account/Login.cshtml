@model RestaurantAi.Mvc.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In - DineAI";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: "#B08E21",
                        charcoal: "#111827",
                        "soft-gray": "#f9fafb"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @@layer base {
            :root {
                --primary: #121212;
                --accent: #B08E21;
                --bg-light: #ffffff;
                --bg-soft-gray: #f9fafb;
                --text-main: #111827;
                --text-muted: #6b7280;
                --border: #e5e7eb;
            }
        }
        .font-display {
            font-family: 'Manrope', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .gold-gradient {
            background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%);
        }
    </style>
</head>
<body class="bg-[var(--bg-light)] font-display text-[var(--text-main)] min-h-screen">

    <header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-white/95 backdrop-blur-md">
        <div class="max-w-[1440px] mx-auto px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-12">
                <div class="flex items-center gap-3">
                    <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                        <span class="material-symbols-outlined font-bold">restaurant_menu</span>
                    </div>
                    <h1 class="text-2xl font-extrabold tracking-tight uppercase text-charcoal">
                        DineAI
                    </h1>
                </div>

                <nav class="hidden lg:flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        EXPLORE
                    </a>
                    <a asp-controller="Home" asp-action="Dashboard"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        CONCIERGE
                    </a>
                    <a asp-controller="Booking" asp-action="Index"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        MY BOOKINGS
                    </a>
                    <a asp-controller="Home" asp-action="Privacy"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-charcoal transition-colors">
                        PRIVACY
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-6">
                <div class="h-6 w-px bg-[var(--border)]"></div>

                <div class="flex items-center gap-4">
                    <a asp-controller="Account" asp-action="Login"
                       class="text-sm font-semibold text-gold hover:text-charcoal transition-colors">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="px-6 py-2.5 bg-gold text-white text-sm font-bold rounded-lg hover:shadow-lg hover:shadow-gold/30 transition-all">
                        Get Started
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="flex h-screen w-full flex-col pt-20">
        <main class="flex flex-1">
            <!-- Left Visual -->
            <div class="hidden lg:flex w-1/2 relative overflow-hidden">
                <div class="absolute inset-0 bg-black/40 z-10"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent to-white/90 z-20"></div>
                <div class="w-full h-full bg-center bg-cover scale-105"
                     style="background-image:url('https://lh3.googleusercontent.com/aida-public/AB6AXuAgrm2lKLLWt187h4bzQQ8RLK6cSQADeMaGAdtF_2FC2xFkJtkrmYX-SMadDVpfYUCgnLaAU3zxpruZGVJE-PYyScwLVqGU_mwfk_SGQRwlAle_Iezb9we4Qe4dlybSFeIO7FyovshGee0yKpkWMhjEBFmQgjp_tkEG1pqdmBnbpRxrHwHt60cg0_Be1vW-_l3hlS62pxigB7FkbTaIsVbm0FmD8pouKXgLHRTO589WFUCChKTQBCutVQBnFKudNGdSSI76DvFBSgg')">
                </div>
                <div class="absolute bottom-20 left-20 z-30 max-w-md">
                    <h2 class="text-5xl font-black text-white leading-tight mb-4 drop-shadow-lg">Discover Exquisite Flavors</h2>
                    <p class="text-lg text-white/80 leading-relaxed drop-shadow">Your next culinary journey is just a sign-in away.</p>
                </div>
            </div>

            <!-- Right Form -->
            <div class="w-full lg:w-1/2 flex items-center justify-center p-8 bg-white overflow-y-auto">
                <div class="max-w-[480px] w-full flex flex-col gap-8 py-10">

                    <!-- AI Prompt -->
                    <div class="flex items-start gap-3 p-4 bg-gold/10 rounded-xl border border-gold/20">
                        <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-12 shrink-0 border-2 border-gold"
                             style="background-image:url('https://lh3.googleusercontent.com/aida-public/AB6AXuA6Z_Z0VsTSJKZka6El_rQ2ymTcLkW_p2j2pwsfuP0b8q2De96h-jBge08Zy-o9TbKtf9CBZsRb7ZkWFXMCxgHigg--1HEM4sKtvJq9tygbDjzTckOmSYg-sBo2MvRxg_nrI88f3SOIndtQ54sUMpxVk4hgUl6Sd-argBJNKH7PpR2SEP7cgmzqhxD9IqI1XDDq7fZPotrcb1T5HG4rMDvm4A6crGBs9fp429TEUFfaXwMErnESl5ZdxJbBL-9IejRw9kuPFLGgBOQ')">
                        </div>
                        <div class="flex flex-1 flex-col gap-1">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[14px] text-gold">auto_awesome</span>
                                <p class="text-gold text-[13px] font-semibold">DineAI Agent</p>
                            </div>
                            <p class="text-[15px] font-normal leading-relaxed text-[var(--text-main)]">Good evening. Shall I find your usual table, or are we exploring something new tonight?</p>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <h1 class="text-charcoal text-4xl font-black leading-tight tracking-[-0.033em]">Welcome Back</h1>
                        <p class="text-[var(--text-muted)] text-base">Sign in to access your curated recommendations and priority bookings.</p>
                    </div>

                    <form asp-action="Login" asp-controller="Account" method="post" class="flex flex-col gap-5">
                        @Html.AntiForgeryToken()
                        <div class="flex flex-col gap-2">
                            <label class="text-charcoal text-sm font-medium">Email Address</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-muted)] group-focus-within:text-gold">mail</span>
                                <input asp-for="Email" class="w-full h-14 pl-12 pr-4 bg-[var(--bg-soft-gray)] border border-[var(--border)] rounded-lg text-charcoal placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all"
                                       placeholder="gourmet@example.com" type="email" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex justify-between items-center">
                                <label class="text-charcoal text-sm font-medium">Password</label>
                                <a asp-action="ForgotPassword" asp-controller="Account" class="text-gold text-xs font-semibold hover:underline">Forgot?</a>
                            </div>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-muted)] group-focus-within:text-gold">lock</span>
                                <input asp-for="Password" class="w-full h-14 pl-12 pr-4 bg-[var(--bg-soft-gray)] border border-[var(--border)] rounded-lg text-charcoal placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all"
                                       placeholder="••••••••" type="password" />
                            </div>
                        </div>
                        <div class="flex items-center gap-2 px-1">
                            <input asp-for="RememberMe" class="w-4 h-4 rounded border-[var(--border)] bg-[var(--bg-soft-gray)] text-gold" id="remember" type="checkbox" />
                            <label class="text-sm text-[var(--text-muted)] select-none" for="remember">Remember me for 30 days</label>
                        </div>
                        <button class="w-full h-14 bg-gold text-white font-extrabold text-lg rounded-lg shadow-[0_4px_20px_rgba(176,142,33,0.3)] hover:shadow-[0_4px_25px_rgba(176,142,33,0.4)] transition-all active:scale-[0.98]" type="submit">
                            Sign In
                        </button>
                    </form>

                    <div class="flex items-center gap-4">
                        <div class="h-[1px] flex-1 bg-[var(--border)]"></div>
                        <span class="text-[var(--text-muted)] text-xs font-bold uppercase tracking-widest">Or login with</span>
                        <div class="h-[1px] flex-1 bg-[var(--border)]"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <a href="/signin-google" class="flex items-center justify-center gap-3 h-12 bg-[var(--bg-soft-gray)] border border-[var(--border)] rounded-lg hover:bg-gray-100 transition-colors">
                            <svg class="w-5 h-5" viewBox="0 0 24 24">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                            <span class="text-sm font-semibold">Google</span>
                        </a>
                        <a href="/signin-apple" class="flex items-center justify-center gap-3 h-12 bg-[var(--bg-soft-gray)] border border-[var(--border)] rounded-lg hover:bg-gray-100 transition-colors">
                            <span class="material-symbols-outlined text-[20px]">ios</span>
                            <span class="text-sm font-semibold">Apple</span>
                        </a>
                    </div>

                    <p class="text-center text-[var(--text-muted)] text-sm">
                        New to DineAI?
                        <a asp-action="Register" asp-controller="Account" class="text-gold font-bold hover:underline">Create an account</a>
                    </p>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
