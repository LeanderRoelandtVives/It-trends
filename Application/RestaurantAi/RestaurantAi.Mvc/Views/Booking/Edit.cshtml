@model RestaurantAi.Mvc.Models.ReservationViewModel
@{
    ViewData["Title"] = "Edit Reservation";
    Layout = "_Layout";
}

<div class="container py-8" style="max-width:920px">
    <h1 class="mb-4">Edit Reservation</h1>

    <div class="row">
        <!-- Left: Edit form using Bootstrap columns to ensure left placement -->
        <div class="col-12 col-lg-7">
            <div class="bg-white rounded-2xl border p-4 p-md-5 shadow-sm">
                <form asp-action="Edit" asp-controller="Booking" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Time</label>
                        <input asp-for="Time" class="form-control" />
                        <span asp-validation-for="Time" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Party Size</label>
                        <input asp-for="PartySize" class="form-control" type="number" min="1" max="20" />
                        <span asp-validation-for="PartySize" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Special Requests</label>
                        <input asp-for="SpecialRequests" class="form-control" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: preview / AI placeholder -->
        <div class="col-12 col-lg-5 mt-4 mt-lg-0">
            <div class="bg-white rounded-2xl border p-4 shadow-sm">
                <h4 class="font-bold mb-3">Reservation Preview</h4>
                <dl>
                    <dt class="text-muted">Date</dt>
                    <dd class="mb-2">@Model.Date.ToString("MMMM d, yyyy")</dd>

                    <dt class="text-muted">Time</dt>
                    <dd class="mb-2">@Model.Time</dd>

                    <dt class="text-muted">Party Size</dt>
                    <dd class="mb-2">@Model.PartySize</dd>

                    <dt class="text-muted">Special Requests</dt>
                    <dd class="mb-2">@Model.SpecialRequests</dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="List" asp-controller="Booking" class="btn btn-outline-secondary">Back to Bookings</a>
                </div>
            </div>

            <div class="mt-3">
                <div class="bg-light rounded-2xl border p-3">
                    <h5 class="mb-2">Concierge AI</h5>
                    <p class="text-sm text-muted mb-0">Use the AI assistant to refine special requests or preferences. Editing is done on the left.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
