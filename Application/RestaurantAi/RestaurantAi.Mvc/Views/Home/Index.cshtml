@{
    Layout = null;
    ViewData["Title"] = "DineAI | Discover & Book Premium Dining";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <script>
        if (localStorage.getItem('theme') === 'dark' ||
            (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <style type="text/tailwindcss">
        @@layer base {
            :root {
                --primary: #121212;
                --accent: #B08E21;
                --bg-light: #ffffff;
                --bg-soft-gray: #f9fafb;
                --text-main: #111827;
                --text-muted: #6b7280;
                --border: #e5e7eb;
                --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 10px -2px rgba(0, 0, 0, 0.03);
            }

            .dark {
                --bg-light: #0f0f0f;
                --bg-soft-gray: #1a1a1a;
                --text-main: #f3f4f6;
                --text-muted: #9ca3af;
                --border: #2d2d2d;
            }
        }

        .font-display {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .gold-gradient {
            background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%);
        }
    </style>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: "#B08E21",
                        charcoal: "#111827",
                        "soft-gray": "#f9fafb"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-[var(--bg-light)] font-display text-[var(--text-main)] min-h-screen transition-colors duration-300">

    <header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--bg-light)]/95 backdrop-blur-md transition-colors duration-300">
        <div class="max-w-[1440px] mx-auto px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-12">
                <div class="flex items-center gap-3">
                    <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                        <span class="material-symbols-outlined font-bold">restaurant_menu</span>
                    </div>
                    <h1 class="text-2xl font-extrabold tracking-tight uppercase text-[var(--text-main)]">
                        DineAI
                    </h1>
                </div>

                <nav class="hidden lg:flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-sm font-bold tracking-wide text-gold transition-colors">
                        EXPLORE
                    </a>
                    <a asp-controller="Home" asp-action="Dashboard"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors">
                        CONCIERGE
                    </a>
                    <a asp-controller="Booking" asp-action="Index"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors">
                        MY BOOKINGS
                    </a>
                    <a asp-controller="Home" asp-action="Privacy"
                       class="text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors">
                        PRIVACY
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-6">
                <div class="h-6 w-px bg-[var(--border)]"></div>
                <button id="theme-toggle" onclick="toggleTheme()"
                        class="p-2 rounded-lg border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-muted)] hover:text-[var(--text-main)] hover:border-gold transition-all"
                        title="Toggle dark mode">
                    <span id="icon-light" class="material-symbols-outlined hidden dark:block text-gold">light_mode</span>
                    <span id="icon-dark" class="material-symbols-outlined block dark:hidden">dark_mode</span>
                </button>
                <div class="h-6 w-px bg-[var(--border)]"></div>
                <div class="flex items-center gap-4">
                    <a asp-controller="Account" asp-action="Login"
                       class="text-sm font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors">
                        Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="px-6 py-2.5 bg-gold text-white text-sm font-bold rounded-lg hover:shadow-lg hover:shadow-gold/30 transition-all">
                        Get Started
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-[1440px] mx-auto px-8 py-10">
        
        <!-- Hero Section -->
        <section class="flex flex-col lg:flex-row items-center gap-16 py-20">
            <div class="flex-1 flex flex-col gap-8">
                <div class="flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
                    <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
                    AI-POWERED DINING CONCIERGE
                </div>
                
                <h1 class="text-6xl md:text-7xl font-black leading-[1.1] tracking-tight">
                    Discover Your<br />
                    <span style="background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">Perfect Meal</span>
                </h1>

                <p class="text-xl text-[var(--text-muted)] leading-relaxed max-w-lg">
                    Experience fine dining like never before with our AI concierge. 
                    Get personalized recommendations, instant reservations, and exclusive access 
                    to the world's best restaurants.
                </p>

                <div class="flex flex-wrap gap-4">
                    <a asp-controller="Home" asp-action="Dashboard"
                       class="px-8 py-4 bg-[var(--text-main)] text-[var(--bg-light)] font-bold rounded-xl hover:shadow-2xl transition-all flex items-center gap-2">
                        Start Exploring
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                    <a asp-controller="Booking" asp-action="Index"
                       class="px-8 py-4 border-2 border-[var(--text-main)] text-[var(--text-main)] font-bold rounded-xl hover:bg-[var(--text-main)] hover:text-[var(--bg-light)] transition-all">
                        View Demo
                    </a>
                </div>

                <div class="flex items-center gap-8 pt-4">
                    <div class="flex flex-col">
                        <p class="text-3xl font-black text-[var(--text-main)]">50K+</p>
                        <p class="text-sm text-[var(--text-muted)] font-medium">Premium Restaurants</p>
                    </div>
                    <div class="h-12 w-px bg-[var(--border)]"></div>
                    <div class="flex flex-col">
                        <p class="text-3xl font-black text-[var(--text-main)]">1M+</p>
                        <p class="text-sm text-[var(--text-muted)] font-medium">Happy Diners</p>
                    </div>
                    <div class="h-12 w-px bg-[var(--border)]"></div>
                    <div class="flex flex-col">
                        <p class="text-3xl font-black text-[var(--text-main)]">4.9★</p>
                        <p class="text-sm text-[var(--text-muted)] font-medium">Average Rating</p>
                    </div>
                </div>
            </div>

            <div class="flex-1 relative">
                <div class="aspect-square rounded-3xl overflow-hidden shadow-2xl">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAfHCWUJ8QDmcSrfgdXgKcFaDG1XLm6bYF632LvR5uFyjp2TjJ6MfMKYIIHeucMz6gUNzVgFL9lug3UseJpN4VBL2_k0I8aMvvKzNf8fn5bfR0YoTOlHHQOqAIQJ1XJT8Y1pdnYJcT0njtPBe3Voh1O2xElZIFX076rdmVuZe4MTRBWXhC500hEqhAunL5wa4QCqJuS7qtDPJhTkUal2V1X2GpAG9R-rVNhg36CR-C4GfzXzQtB_f0T_UUz60BZSUC6dA5B618I1JY"
                         alt="Fine dining experience"
                         class="w-full h-full object-cover" />
                </div>
                <div class="absolute -bottom-6 -left-6 bg-[var(--bg-light)] p-6 rounded-2xl shadow-xl border border-[var(--border)] max-w-xs">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="material-symbols-outlined text-gold">smart_toy</span>
                        <p class="text-xs font-black uppercase tracking-wider text-gold">AI RECOMMENDATION</p>
                    </div>
                    <p class="text-sm font-semibold">"Based on your taste profile, you'll love the seasonal tasting menu at L'Artiste."</p>
                </div>
            </div>
        </section>

        <!-- Featured Restaurants -->
        <section class="py-20 border-t border-[var(--border)]">
            <div class="flex items-center justify-between mb-12">
                <div>
                    <h2 class="text-4xl font-black mb-2">Recommended for You</h2>
                    <p class="text-[var(--text-muted)] font-medium">Curated by our AI based on your preferences</p>
                </div>
                <a asp-controller="Home" asp-action="Dashboard"
                   class="text-sm font-bold text-gold hover:underline flex items-center gap-1">
                    View All
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var restaurant in new[] {
                    new { Name = "L'Artiste", Cuisine = "French Fine Dining", Distance = "0.8 miles", Rating = "4.9", Price = "$$$$", Image = "https://lh3.googleusercontent.com/aida-public/AB6AXuAc6UBg8woNfBPGRSGfbt33r9Mv8hmvJnLJveF8NyIixkXbnbQIgBJ11_L7CszYyDytnc6thStrCZ4o72TCbe82fg7vhpSVYf07ZzqSBrWKD4SU3ndAzK2syt5BU89fLvB2UQUmkcdnUEvUgY3bJIxuuQUiiyC1kaV7NdLnocA9_wMsF5xAd_rlNGK1TLOMkMJqAPpmHth_6krTrUPyayejbckxgFVLygCxyshVZwrRwKml49qmPosVOTuTlvAIOA9vOleQUkz08oA" },
                    new { Name = "Sushi Zen", Cuisine = "Japanese Omakase", Distance = "1.2 miles", Rating = "4.8", Price = "$$$", Image = "https://lh3.googleusercontent.com/aida-public/AB6AXuA_D7mFbwxbgLy6hUqAqmC6B0crLwMdTNZ5XEWIdiuff0lj77wio9jZC5K3hjvrx4rlVfRXvd5Ii2Th4F6i2KG29xG9nOj2DOxCRxJWVn-nXNEGD9IJA8DYl1wwQL336HjO0C7xvd_J29ASfhd-P4JQ4aSu6fKpw6WaNOqflU2cmU57TemhuP30fyGWHFFu7OkIhiVaLSzzJxyCuP4d4WbHg_zFGM9DL0VY0DSEGuwOfdVHXC6c3upJcjTLX8BV2bsKLRTqSp-CMm4" },
                    new { Name = "The Pasta House", Cuisine = "Italian Trattoria", Distance = "0.5 miles", Rating = "4.7", Price = "$$", Image = "https://lh3.googleusercontent.com/aida-public/AB6AXuDB5PnFsctL0DffbZvChcRKCiwvkGI7Px1bi3oMdUjpJsAJvCkpBNgWtnZ6Qzr9eE-5OjgIo4BQnDrJRLVvIZ3XApmzBQDus6PuV8vbmioO8dyHP3yk1N0IcJ3yIc--nNbyPAHy2lvZD7Qd3lYcAVn9dFKOu24xARPq00yCb4XnM5vkylrIJbpaBASomA8uJ9tGOTvPlLsagxGpS7sDn8Nnx4D0xXQ_fPz8eXbDX7rwG6Ad4oHSyoQXQ3p9PINCYWtCHz6yugARsbA" }
                })
                {
                    <div class="group bg-[var(--bg-light)] rounded-2xl overflow-hidden border border-[var(--border)] hover:shadow-xl transition-all duration-300 cursor-pointer">
                        <div class="aspect-[4/3] overflow-hidden relative">
                            <img src="@restaurant.Image" alt="@restaurant.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            <div class="absolute top-4 right-4 bg-[var(--bg-light)]/90 backdrop-blur-md px-3 py-1.5 rounded-lg flex items-center gap-1 font-bold text-sm">
                                <span class="material-symbols-outlined text-[16px] text-amber-500">star</span>
                                @restaurant.Rating
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-black mb-2">@restaurant.Name</h3>
                            <p class="text-sm text-[var(--text-muted)] mb-4">@restaurant.Cuisine • @restaurant.Price</p>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1 text-sm text-[var(--text-muted)]">
                                    <span class="material-symbols-outlined text-[16px]">location_on</span>
                                    @restaurant.Distance
                                </div>
                                <a asp-controller="Booking" asp-action="Index"
                                   class="px-4 py-2 bg-[var(--text-main)] text-[var(--bg-light)] text-sm font-bold rounded-lg hover:bg-gold transition-colors">
                                    Reserve
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Features -->
        <section class="py-20 border-t border-[var(--border)]">
            <div class="text-center mb-16">
                <div class="flex items-center justify-center gap-2 text-gold font-bold text-sm uppercase tracking-widest mb-4">
                    <span class="material-symbols-outlined text-[18px]">stars</span>
                    WHY CHOOSE DINEAI
                </div>
                <h2 class="text-5xl font-black mb-4">Premium Dining Made Simple</h2>
                <p class="text-xl text-[var(--text-muted)] max-w-2xl mx-auto">
                    Experience the future of restaurant discovery and booking with our AI-powered platform
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @foreach (var feature in new[] {
                    new { Icon = "psychology", Title = "AI Personalization", Description = "Our advanced AI learns your taste preferences and dietary restrictions to recommend the perfect dining experiences just for you." },
                    new { Icon = "flash_on", Title = "Instant Booking", Description = "Reserve tables at top restaurants in seconds. Real-time availability and instant confirmations make planning effortless." },
                    new { Icon = "workspace_premium", Title = "Exclusive Access", Description = "Get priority reservations and access to members-only events at the world's most sought-after restaurants." }
                })
                {
                    <div class="bg-[var(--bg-soft-gray)] rounded-2xl p-8 hover:shadow-lg transition-all">
                        <div class="size-16 gold-gradient rounded-2xl flex items-center justify-center text-white mb-6">
                            <span class="material-symbols-outlined text-3xl">@feature.Icon</span>
                        </div>
                        <h3 class="text-2xl font-black mb-3">@feature.Title</h3>
                        <p class="text-[var(--text-muted)] leading-relaxed">@feature.Description</p>
                    </div>
                }
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-20 border-t border-[var(--border)]">
            <div class="bg-charcoal text-white rounded-3xl p-16 text-center relative overflow-hidden">
                <div class="absolute inset-0 opacity-10">
                    <div class="absolute top-10 left-10 size-32 bg-gold rounded-full blur-3xl"></div>
                    <div class="absolute bottom-10 right-10 size-40 bg-gold rounded-full blur-3xl"></div>
                </div>
                <div class="relative z-10">
                    <h2 class="text-5xl font-black mb-6">Ready to Elevate Your Dining?</h2>
                    <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
                        Join over 1 million food enthusiasts discovering extraordinary dining experiences with DineAI
                    </p>
                    <div class="flex flex-wrap gap-4 justify-center">
                        <a asp-controller="Account" asp-action="Register"
                           class="px-10 py-4 bg-gold text-white font-bold rounded-xl hover:shadow-2xl hover:shadow-gold/30 transition-all flex items-center gap-2">
                            Create Free Account
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a asp-controller="Home" asp-action="Dashboard"
                           class="px-10 py-4 bg-white text-charcoal font-bold rounded-xl hover:shadow-2xl transition-all">
                            Explore Restaurants
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="border-t border-[var(--border)] py-16 bg-[var(--bg-soft-gray)]">
        <div class="max-w-[1440px] mx-auto px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <div class="col-span-1">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                            <span class="material-symbols-outlined font-bold">restaurant_menu</span>
                        </div>
                        <h2 class="text-2xl font-extrabold uppercase">DineAI</h2>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        AI-powered dining discovery and reservation platform for discerning food lovers.
                    </p>
                </div>
                <div>
                    <h3 class="font-black text-sm uppercase tracking-widest mb-4">Platform</h3>
                    <ul class="space-y-3">
                        <li><a asp-controller="Home" asp-action="Dashboard" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Explore</a></li>
                        <li><a asp-controller="Booking" asp-action="Index" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">My Bookings</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Collections</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Favorites</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-black text-sm uppercase tracking-widest mb-4">Company</h3>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">About Us</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Careers</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Press</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Partners</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-black text-sm uppercase tracking-widest mb-4">Legal</h3>
                    <ul class="space-y-3">
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Terms of Service</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Cookie Policy</a></li>
                        <li><a href="#" class="text-sm text-[var(--text-muted)] hover:text-gold transition-colors">Support</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-[var(--border)] pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">
                    © @DateTime.Now.Year DineAI Luxury Group. All rights reserved.
                </p>
                <div class="flex gap-6">
                    <a href="#" class="text-[var(--text-muted)] hover:text-gold transition-colors">
                        <span class="material-symbols-outlined">language</span>
                    </a>
                    <a href="#" class="text-[var(--text-muted)] hover:text-gold transition-colors">
                        <span class="material-symbols-outlined">chat</span>
                    </a>
                    <a href="#" class="text-[var(--text-muted)] hover:text-gold transition-colors">
                        <span class="material-symbols-outlined">help</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }
    </script>
</body>
</html>
