@model RestaurantAi.Mvc.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In - DineAI";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: "#B08E21",
                        charcoal: "#111827",
                        "soft-gray": "#f9fafb"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @@layer base {
            :root {
                --primary: #121212;
                --accent: #B08E21;
                --bg-light: #ffffff;
                --bg-soft-gray: #f9fafb;
                --text-main: #111827;
                --text-muted: #6b7280;
                --border: #e5e7eb;
            }
        }

        .font-display {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .gold-gradient {
            background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%);
        }
    </style>
</head>
<body class="bg-[var(--bg-light)] font-display text-[var(--text-main)] min-h-screen">

    <header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-white/95 backdrop-blur-md">
        <div class="max-w-[1440px] mx-auto px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-12">
                <div class="flex items-center gap-3">
                    <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                        <span class="material-symbols-outlined font-bold">restaurant_menu</span>
                    </div>
                    <h1 class="text-2xl font-extrabold tracking-tight uppercase text-charcoal">
                        DineAI
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <a asp-controller="Account" asp-action="Login"
                   class="text-sm font-semibold text-gold hover:text-charcoal transition-colors">
                    Sign In
                </a>
                <a asp-controller="Account" asp-action="Register"
                   class="px-6 py-2.5 bg-gold text-white text-sm font-bold rounded-lg hover:shadow-lg hover:shadow-gold/30 transition-all">
                    Get Started
                </a>
            </div>
        </div>
    </header>

    <div class="flex h-screen w-full flex-col pt-20">
        <main class="flex flex-1">

            <!-- Right Form -->
            <div class="w-full flex items-center justify-center p-8 bg-white overflow-y-auto">

                <div class="max-w-[480px] w-full flex flex-col gap-8 py-10">

                    <h1 class="text-charcoal text-4xl font-black leading-tight">Welcome Back</h1>
                    <p class="text-[var(--text-muted)]">Sign in to continue.</p>

                    <form asp-action="Login" asp-controller="Account" method="post" class="flex flex-col gap-5">

                        @Html.AntiForgeryToken()

                        <!-- LOGIN ERRORS -->
                        <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                        <!-- EMAIL -->
                        <div class="flex flex-col gap-2">
                            <label class="text-sm font-medium">Email</label>

                            <input asp-for="Email"
                                   class="w-full h-12 px-4 border border-gray-300 rounded-lg focus:ring-gold focus:border-gold"
                                   placeholder="email@example.com"
                                   type="email" />

                            <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="flex flex-col gap-2">
                            <label class="text-sm font-medium">Password</label>

                            <input asp-for="Password"
                                   class="w-full h-12 px-4 border border-gray-300 rounded-lg focus:ring-gold focus:border-gold"
                                   type="password" />

                            <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
                        </div>

                        <!-- REMEMBER ME -->
                        <div class="flex items-center gap-2">
                            <input asp-for="RememberMe" type="checkbox" class="h-4 w-4" />
                            <label asp-for="RememberMe">Remember me</label>
                        </div>

                        <!-- SUBMIT -->
                        <button type="submit"
                                class="w-full h-12 bg-gold text-white font-bold rounded-lg hover:bg-yellow-700 transition">
                            Sign In
                        </button>

                    </form>

                    <div class="flex items-center gap-4 my-6">
                        <div class="flex-1 h-px bg-[var(--border)]"></div>
                        <span class="text-sm text-[var(--text-muted)] font-medium">or</span>
                        <div class="flex-1 h-px bg-[var(--border)]"></div>
                    </div>

                    <a asp-controller="Account" asp-action="LoginWithGoogle"
                       class="w-full flex items-center justify-center gap-3 px-6 py-3 border-2 border-[var(--border)] rounded-xl font-bold text-sm hover:border-charcoal transition-all">
                        <svg width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                            <path fill="none" d="M0 0h48v48H0z" />
                        </svg>
                        Continue with Google
                    </a>

                    <p class="text-center text-sm text-gray-500">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" class="text-gold font-bold hover:underline">
                            Create one
                        </a>
                    </p>

                </div>
            </div>
        </main>
    </div>

</body>
</html>
