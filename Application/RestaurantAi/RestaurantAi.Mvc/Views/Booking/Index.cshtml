@model RestaurantAi.Mvc.Models.ReservationViewModel
@{
    ViewData["Title"] = "DineReserve AI - Assisted Booking";
}

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none
    }
</style>

<div class="layout-container flex h-full grow flex-col">
    <main class="flex-1 flex justify-center py-6 lg:py-10">
        <div class="flex flex-col w-full max-w-[1280px] px-4 md:px-8">

            @{
                if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

            }
            @{
                if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

            }

            <div class="flex flex-wrap justify-between items-end gap-4 mb-10">
                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
                        <span class="material-symbols-outlined text-[16px]">restaurant</span>
                        Reservation Request
                    </div>
                    <h1 class="text-3xl md:text-5xl font-black leading-tight tracking-tight">Table for Two at L'Artiste</h1>
                    <div class="flex items-center gap-3">
                        <span class="text-[var(--text-muted)] text-base font-medium flex items-center gap-1">
                            <span class="material-symbols-outlined text-[18px]">location_on</span> Manhattan, NY
                        </span>
                        <span>&bull;</span>
                        <span class="text-[var(--text-muted)] text-base font-medium">French Fine Dining</span>
                        <span>&bull;</span>
                        <div class="flex items-center gap-1 bg-amber-100 text-amber-700 px-2 py-0.5 rounded-lg text-sm font-bold">
                            <span class="material-symbols-outlined text-[14px]">star</span> 4.8
                        </div>
                    </div>
                </div>
                <a asp-action="Index" asp-controller="Home"
                   class="flex items-center gap-2 rounded-xl h-11 px-6 bg-[var(--bg-soft-gray)] text-[var(--text-main)] text-sm font-bold hover:bg-[var(--bg-light)] transition-all border border-[var(--border)]">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to Discovery
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

                <!-- Left: Reservation Form -->
                <div class="lg:col-span-7 flex flex-col gap-8">
                    <div class="bg-[var(--bg-light)] rounded-2xl border border-[var(--border)] p-8 shadow-sm">
                        <div class="flex items-center gap-2 mb-6">
                            <span class="material-symbols-outlined text-gold">description</span>
                            <h3 class="text-xl font-bold">Make a Reservation</h3>
                        </div>

                        <form asp-action="Create" asp-controller="Booking" method="post" class="space-y-5">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Date</label>
                                <input asp-for="Date" type="date" class="form-control form-input rounded-xl w-full h-12 px-4" />
                                <span asp-validation-for="Date" class="text-danger text-xs"></span>
                            </div>

                            <div class="form-group">
                                <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Time</label>
                                <input asp-for="Time" class="form-control form-input rounded-xl w-full h-12 px-4" placeholder="7:00 PM" />
                                <span asp-validation-for="Time" class="text-danger text-xs"></span>
                            </div>

                            <div class="form-group">
                                <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Party Size</label>
                                <input asp-for="PartySize" type="number" min="1" max="20" class="form-control form-input rounded-xl w-full h-12 px-4" />
                                <span asp-validation-for="PartySize" class="text-danger text-xs"></span>
                            </div>

                            <div class="form-group">
                                <label class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-widest mb-1 block">Special Requests</label>
                                <input asp-for="SpecialRequests" class="form-control form-input rounded-xl w-full h-12 px-4" placeholder="Allergies, seating, etc." />
                            </div>

                            <div class="flex items-center gap-3 pt-2">
                                <button type="submit" class="flex items-center gap-2 h-12 px-6 bg-gold text-white font-black rounded-xl shadow-lg shadow-gold/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span> Confirm Reservation
                                </button>
                                <a asp-action="List" asp-controller="Booking" class="flex items-center gap-2 h-12 px-6 border border-[var(--border)] rounded-xl font-bold text-sm hover:bg-[var(--bg-soft-gray)] transition-colors">
                                    View My Bookings
                                </a>
                            </div>
                        </form>
                    </div>

                    <div class="flex gap-5 p-6 rounded-2xl bg-gold/5 border border-gold/10 items-start">
                        <div class="size-10 rounded-full bg-gold/20 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-gold">notifications_active</span>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-base mb-1">Reservation Policy</h4>
                            <p class="text-sm text-[var(--text-muted)] leading-relaxed">Tables are held for 15 minutes. Cancellations made within 24 hours may incur a $25 fee per guest.</p>
                        </div>
                    </div>
                </div>

                <!-- Right: AI Concierge Chat -->
                <div class="lg:col-span-5 flex flex-col h-[700px] bg-[var(--bg-light)] rounded-2xl border border-[var(--border)] overflow-hidden shadow-2xl">
                    <div class="p-5 border-b border-[var(--border)] flex items-center justify-between bg-[var(--bg-soft-gray)]">
                        <div class="flex items-center gap-4">
                            <div class="relative">
                                <div class="size-11 rounded-2xl bg-gold flex items-center justify-center text-white shadow-lg shadow-gold/30">
                                    <span class="material-symbols-outlined">smart_toy</span>
                                </div>
                                <span class="absolute -bottom-1 -right-1 size-4 bg-emerald-500 border-2 border-white rounded-full"></span>
                            </div>
                            <div>
                                <h3 class="font-extrabold text-base">Concierge AI</h3>
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1 bg-emerald-500 rounded-full animate-pulse"></span>
                                    <span class="size-1 bg-emerald-500 rounded-full animate-pulse delay-75"></span>
                                    <span class="size-1 bg-emerald-500 rounded-full animate-pulse delay-150"></span>
                                    <p class="text-[11px] font-bold text-emerald-500 uppercase tracking-tighter">Analyzing your preferences</p>
                                </div>
                            </div>
                        </div>
                        <button class="p-2 text-[var(--text-muted)] hover:text-[var(--text-main)]">
                            <span class="material-symbols-outlined">tune</span>
                        </button>
                    </div>

                    <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6 no-scrollbar">
                        <div class="flex flex-col gap-1.5 max-w-[85%] self-start">
                            <div class="bg-[var(--bg-soft-gray)] p-4 rounded-2xl rounded-tl-none shadow-sm">
                                <p class="text-sm font-medium leading-relaxed">Bonjour! I've confirmed availability for October 5th at 7:00 PM for 2 guests. Would you like to proceed?</p>
                            </div>
                            <span class="text-[10px] font-bold text-[var(--text-muted)] ml-1 uppercase">11:42 AM &bull; Delivered</span>
                        </div>
                        <div class="flex flex-col gap-1.5 max-w-[85%] self-end">
                            <div class="bg-gold p-4 rounded-2xl rounded-tr-none text-white shadow-lg shadow-gold/10">
                                <p class="text-sm font-medium leading-relaxed">Yes, please. It's for my wife's birthday, and she has a shellfish allergy. A window seat would be lovely.</p>
                            </div>
                            <span class="text-[10px] font-bold text-[var(--text-muted)] mr-1 text-right uppercase">11:43 AM &bull; Read</span>
                        </div>
                        <div class="flex flex-col gap-1.5 max-w-[85%] self-start">
                            <div class="bg-[var(--bg-soft-gray)] p-4 rounded-2xl rounded-tl-none shadow-sm">
                                <p class="text-sm font-medium">Magnifique! I've noted the shellfish allergy for the chef. Securing a window seat for your 7:00 PM arrival...</p>
                            </div>
                        </div>

                        <div class="bg-gold/5 border-2 border-dashed border-gold/30 p-5 rounded-2xl">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="material-symbols-outlined text-gold">description</span>
                                <h4 class="text-sm font-black text-gold uppercase tracking-widest">Reservation Draft</h4>
                            </div>
                            <div class="space-y-3">
                                <div class="flex justify-between items-center py-1 border-b border-gold/10">
                                    <span class="text-xs font-semibold text-[var(--text-muted)]">Date &amp; Time</span>
                                    <span class="text-xs font-black">@Model.Date.ToString("MMM d, yyyy") · @Model.Time</span>
                                </div>
                                <div class="flex justify-between items-center py-1 border-b border-gold/10">
                                    <span class="text-xs font-semibold text-[var(--text-muted)]">Occasion</span>
                                    <span class="text-xs font-black text-pink-500 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">cake</span> Special Occasion</span>
                                </div>
                                <div class="flex justify-between items-center py-1">
                                    <span class="text-xs font-semibold text-[var(--text-muted)]">Special Requests</span>
                                    <span class="text-xs font-black">@Model.SpecialRequests</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-5 bg-[var(--bg-soft-gray)] border-t border-[var(--border)] backdrop-blur-md">
                        <div class="flex gap-3 mb-4 overflow-x-auto no-scrollbar pb-1">
                            <button class="whitespace-nowrap px-4 py-1.5 rounded-full border border-[var(--border)] text-[11px] font-bold bg-[var(--bg-soft-gray)] hover:bg-[var(--bg-light)] transition-colors">Add high chair</button>
                            <button class="whitespace-nowrap px-4 py-1.5 rounded-full border border-[var(--border)] text-[11px] font-bold bg-[var(--bg-soft-gray)] hover:bg-[var(--bg-light)] transition-colors">Outdoor seating?</button>
                            <button class="whitespace-nowrap px-4 py-1.5 rounded-full border border-[var(--border)] text-[11px] font-bold bg-[var(--bg-soft-gray)] hover:bg-[var(--bg-light)] transition-colors">Pre-order wine</button>
                        </div>
                        <div class="flex gap-2">
                            <div class="relative flex-1">
                                <input class="w-full bg-[var(--bg-soft-gray)] text-[var(--text-main)] border border-[var(--border)] rounded-xl text-sm px-4 py-3 focus:ring-2 focus:ring-gold focus:border-transparent outline-none transition-all" placeholder="Message Concierge AI..." type="text" />
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] cursor-pointer">mic</span>
                            </div>
                            <button class="size-11 bg-gold rounded-xl flex items-center justify-center text-white shrink-0 shadow-lg shadow-gold/20 hover:scale-[1.05] active:scale-[0.95] transition-all">
                                <span class="material-symbols-outlined">send</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mt-16 flex flex-col md:flex-row justify-between items-center gap-8 py-10 border-t border-[var(--border)]">
                <div class="flex items-center gap-4 text-[var(--text-muted)]">
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-bold uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[16px] text-emerald-500">verified_user</span> SSL Secured
                    </div>
                    <p class="text-xs font-medium">&copy; @DateTime.Now.Year DineReserve AI. All rights reserved.</p>
                </div>
                <div class="flex gap-8">
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" href="#">Terms</a>
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" asp-action="Privacy" asp-controller="Home">Privacy</a>
                    <a class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] hover:text-gold transition-colors" href="#">Support</a>
                </div>
            </footer>
        </div>
    </main>
</div>

<script>
    // Simple language switcher for Booking page
    let currentLang = localStorage.getItem('language') || 'en';

    function setLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('language', lang);
        document.getElementById('currentLanguage').textContent = lang.toUpperCase();
        document.getElementById('languageMenu').classList.add('hidden');
    }

    // Set initial language
    document.getElementById('currentLanguage').textContent = currentLang.toUpperCase();

    // Toggle language menu
    document.getElementById('languageButton')?.addEventListener('click', function(e) {
        e.stopPropagation();
        document.getElementById('languageMenu').classList.toggle('hidden');
    });

    // Close menu when clicking outside
    document.addEventListener('click', function(e) {
        const menu = document.getElementById('languageMenu');
        const button = document.getElementById('languageButton');
        if (menu && button && !menu.contains(e.target) && !button.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

    window.setLanguage = setLanguage;
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
