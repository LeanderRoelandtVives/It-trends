@{
    ViewData["Title"] = "Privacy Policy - DineAI";
}

<main class="max-w-5xl mx-auto px-6 lg:px-10 py-16">
    <div class="flex flex-col gap-8">
        <div class="flex items-center gap-3 text-gold">
            <span class="material-symbols-outlined">policy</span>
            <span class="text-xs font-black uppercase tracking-widest">Legal Information</span>
        </div>

        <h1 class="text-5xl md:text-6xl font-black leading-tight tracking-tight">Privacy Policy</h1>

        <p class="text-lg text-[var(--text-muted)] leading-relaxed">
            Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")
        </p>

        <div class="bg-gold/5 border border-gold/20 rounded-2xl p-8">
            <div class="flex items-start gap-4">
                <div class="size-12 rounded-xl bg-gold/20 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-gold">security</span>
                </div>
                <div>
                    <h2 class="text-xl font-bold mb-2">Your Privacy Matters</h2>
                    <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        At DineAI, we take your privacy seriously. This policy outlines how we collect, use, and protect your personal information.
                    </p>
                </div>
            </div>
        </div>

        <div class="prose prose-slate max-w-none">
            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">1. Information We Collect</h2>
                <p class="text-[var(--text-muted)] leading-relaxed mb-4">
                    We collect information you provide directly to us, including:
                </p>
                <ul class="list-disc list-inside space-y-2 text-[var(--text-muted)]">
                    <li>Account information (name, email, phone number)</li>
                    <li>Dining preferences and dietary restrictions</li>
                    <li>Reservation history and booking details</li>
                    <li>Payment information (processed securely through third-party providers)</li>
                    <li>Communication preferences and feedback</li>
                </ul>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">2. How We Use Your Information</h2>
                <p class="text-[var(--text-muted)] leading-relaxed mb-4">
                    We use the information we collect to:
                </p>
                <ul class="list-disc list-inside space-y-2 text-[var(--text-muted)]">
                    <li>Process and manage your restaurant reservations</li>
                    <li>Provide personalized dining recommendations through our AI concierge</li>
                    <li>Send booking confirmations and reminders</li>
                    <li>Improve our services and user experience</li>
                    <li>Communicate with you about updates, promotions, and special offers</li>
                </ul>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">3. Data Security</h2>
                <p class="text-[var(--text-muted)] leading-relaxed">
                    We implement industry-standard security measures to protect your personal information. This includes encryption,
                    secure servers, and regular security audits. However, no method of transmission over the internet is 100% secure,
                    and we cannot guarantee absolute security.
                </p>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">4. Sharing Your Information</h2>
                <p class="text-[var(--text-muted)] leading-relaxed mb-4">
                    We may share your information with:
                </p>
                <ul class="list-disc list-inside space-y-2 text-[var(--text-muted)]">
                    <li>Restaurants where you make reservations</li>
                    <li>Payment processors to complete transactions</li>
                    <li>Service providers who assist in operating our platform</li>
                    <li>Law enforcement when required by law</li>
                </ul>
                <p class="text-[var(--text-muted)] leading-relaxed mt-4">
                    We do not sell your personal information to third parties.
                </p>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">5. Your Rights</h2>
                <p class="text-[var(--text-muted)] leading-relaxed mb-4">
                    You have the right to:
                </p>
                <ul class="list-disc list-inside space-y-2 text-[var(--text-muted)]">
                    <li>Access and review your personal information</li>
                    <li>Request corrections to your data</li>
                    <li>Delete your account and associated data</li>
                    <li>Opt-out of marketing communications</li>
                    <li>Export your data in a portable format</li>
                </ul>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 mb-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">6. Cookies and Tracking</h2>
                <p class="text-[var(--text-muted)] leading-relaxed">
                    We use cookies and similar tracking technologies to enhance your experience, analyze usage patterns, and
                    deliver personalized content. You can control cookie settings through your browser preferences.
                </p>
            </div>

            <div class="bg-[var(--bg-light)] border border-[var(--border)] rounded-2xl p-8 shadow-sm">
                <h2 class="text-2xl font-bold mb-4">7. Contact Us</h2>
                <p class="text-[var(--text-muted)] leading-relaxed mb-4">
                    If you have questions about this Privacy Policy or wish to exercise your rights, please contact us:
                </p>
                <div class="flex flex-col gap-2 text-[var(--text-muted)]">
                    <p class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-gold">mail</span>
                        <strong>Email:</strong> privacy@dineai.com
                    </p>
                    <p class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-gold">phone</span>
                        <strong>Phone:</strong> 1-800-DINE-AI1
                    </p>
                    <p class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-gold">location_on</span>
                        <strong>Address:</strong> 123 Tech Boulevard, San Francisco, CA 94102
                    </p>
                </div>
            </div>
        </div>

        <div class="bg-gold/5 border border-gold/20 rounded-2xl p-6 mt-8">
            <div class="flex items-start gap-4">
                <span class="material-symbols-outlined text-gold">info</span>
                <div>
                    <h3 class="font-bold text-[var(--text-main)] mb-2">Policy Updates</h3>
                    <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        We may update this Privacy Policy from time to time. We will notify you of any significant changes
                        by posting the new policy on this page and updating the "Last updated" date.
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>
