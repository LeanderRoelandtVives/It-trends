@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestaurantAi.Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantAi.Mvc.styles.css" asp-append-version="true" />
    <script>
        // Ensure Tailwind uses class-based dark mode when the CDN loads
        window.tailwind = window.tailwind || {};
        window.tailwind.config = window.tailwind.config || {};
        window.tailwind.config.darkMode = 'class';
    </script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        if (localStorage.getItem('theme') === 'dark' ||
            (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style type="text/tailwindcss">
        @@layer base {
            :root {
                --primary: #121212;
                --accent: #B08E21;
                --bg-light: #ffffff;
                --bg-soft-gray: #f9fafb;
                --text-main: #111827;
                --text-muted: #6b7280;
                --border: #e5e7eb;
            }

            .dark {
                --bg-light: #0f0f0f;
                --bg-soft-gray: #1a1a1a;
                --text-main: #f3f4f6;
                --text-muted: #9ca3af;
                --border: #2d2d2d;
            }
        }

        .font-display {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .gold-gradient {
            background: linear-gradient(135deg, #B08E21 0%, #D4AF37 100%);
        }
    </style>
    <script>
        // Additional Tailwind config (will merge with the preloaded config)
        tailwind.config = Object.assign(tailwind.config || {}, {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { gold: "#B08E21", charcoal: "#111827", "soft-gray": "#f9fafb" },
                    fontFamily: { display: ["Manrope", "sans-serif"] }
                }
            }
        });
    </script>
</head>
<body class="bg-[var(--bg-light)] font-display text-[var(--text-main)] min-h-screen transition-colors duration-300">
    @{
        string? loggedInUser = null;
        bool isAdmin = false;
        string? subClaim = null;
        var jwtToken = Context.Session.GetString("JWToken");
        if (!string.IsNullOrEmpty(jwtToken))
        {
            try
            {
                var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
                var jwt = handler.ReadJwtToken(jwtToken);

                loggedInUser = jwt.Claims
                .FirstOrDefault(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
                || c.Type == "name")
                ?.Value;

                isAdmin = jwt.Claims
                .Any(c => (c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"
                || c.Type == ClaimTypes.Role
                || c.Type == "role")
                && c.Value == "Admin");

                subClaim = jwt.Claims.FirstOrDefault(c => c.Type == System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub)?.Value;
            }
            catch { }
        }

        var env = Context.RequestServices.GetService(typeof(IWebHostEnvironment)) as IWebHostEnvironment;
    }

    <header class="bg-[var(--bg-light)]/95 border-b border-[var(--border)] sticky top-0 z-50">
        <div class="layout-content-container mx-auto flex items-center justify-between gap-8 px-4 md:px-8 py-4 max-w-[1280px]">
            <div class="flex items-center gap-4">
                <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                    <span class="material-symbols-outlined">restaurant_menu</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" class="text-xl font-extrabold uppercase tracking-tight no-underline">DineAI</a>
            </div>

            <nav class="hidden lg:flex items-center gap-6 text-sm text-[var(--text-muted)]">
                <a asp-controller="Home" asp-action="Dashboard" class="hover:text-[var(--text-main)]">Concierge</a>
                @if (loggedInUser != null)
                {
                    <a asp-controller="Menu" asp-action="Index" class="hover:text-[var(--text-main)]">Menu</a>
                }
                <a asp-controller="Booking" asp-action="Index" class="hover:text-[var(--text-main)]">My Bookings</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-[var(--text-main)]">Privacy</a>
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Users" class="text-gold">Admin</a>
                }
            </nav>

            <div class="flex items-center gap-3">
                <button id="theme-toggle" onclick="toggleTheme()" class="px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg-soft-gray)] text-[var(--text-muted)]" title="Toggle dark mode"> <span class="material-symbols-outlined">dark_mode</span></button>

                @if (loggedInUser != null)
                {
                    <span class="text-sm font-semibold">Hello, @loggedInUser</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-4 py-2 bg-gold text-white rounded-lg">Sign Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-sm">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="px-3 py-2 bg-gold text-white rounded-lg">Get Started</a>
                }
            </div>
        </div>
    </header>

    @* Main content wrapper to match other pages *@
    <div class="layout-container flex h-full grow flex-col">
        <main class="flex-1 flex justify-center py-6 lg:py-10">
            <div class="layout-content-container flex flex-col w-full max-w-[1280px] px-4 md:px-8">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="bg-[var(--bg-soft-gray)] border-t border-[var(--border)]">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-8">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="size-10 gold-gradient rounded-lg flex items-center justify-center text-white">
                            <span class="material-symbols-outlined">restaurant_menu</span>
                        </div>
                        <h3 class="text-lg font-extrabold uppercase">DineAI</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)]">AI-powered dining discovery and reservation platform for discerning food lovers.</p>
                </div>
                <div>
                    <h4 class="font-black text-sm uppercase tracking-widest mb-4">Platform</h4>
                    <ul class="space-y-3 text-sm text-[var(--text-muted)]">
                        <li><a asp-controller="Home" asp-action="Dashboard" class="hover:text-[var(--text-main)]">Explore</a></li>
                        <li><a asp-controller="Booking" asp-action="Index" class="hover:text-[var(--text-main)]">My Bookings</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Collections</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Favorites</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-black text-sm uppercase tracking-widest mb-4">Company</h4>
                    <ul class="space-y-3 text-sm text-[var(--text-muted)]">
                        <li><a href="#" class="hover:text-[var(--text-main)]">About Us</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Careers</a></li>
                        <li><a href="#" class="hover:text-[var,--text-main)]">Partners</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-black text-sm uppercase tracking-widest mb-4">Legal</h4>
                    <ul class="space-y-3 text-sm text-[var(--text-muted)]">
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-[var(--text-main)]">Privacy Policy</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Terms of Service</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Cookie Policy</a></li>
                        <li><a href="#" class="hover:text-[var(--text-main)]">Support</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-[var(--border)] pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-xs text-[var(--text-muted)]">© @DateTime.Now.Year DineAI. All rights reserved.</p>
                <div class="flex gap-6 text-[var(--text-muted)]">
                    <a href="#" class="hover:text-[var(--text-main)]">Terms</a>
                    <a href="#" class="hover:text-[var(--text-main)]">Privacy</a>
                    <a href="#" class="hover:text-[var(--text-main)]">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }
    </script>
</body>
</html>
